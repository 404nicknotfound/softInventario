<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="presentacion.controllers.LoginController"
            prefWidth="400" prefHeight="300">

    <VBox alignment="CENTER" spacing="15"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="Xian POS" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <TextField fx:id="txtUsername" promptText="Usuario" maxWidth="250"/>

        <PasswordField fx:id="txtContrasena" promptText="Contraseña" maxWidth="250"/>

        <Button text="Iniciar Sesión" onAction="#handleLogin" maxWidth="250"/>

    </VBox>

</AnchorPane>