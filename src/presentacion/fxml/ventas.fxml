<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="presentacion.controllers.VentasController"
            prefWidth="800" prefHeight="600">

    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #2c3e50;">
            <Label text="Xian POS" 
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Inventario" onAction="#handleInventario"/>
            <Button text="Historial" onAction="#handleHistorial"/>
            <Button text="Cerrar Sesión" onAction="#handleCerrarSesion"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 15;">
            <HBox spacing="10">
                <TextField fx:id="txtCodigo" promptText="Código de barras" prefWidth="250"/>
                <Button text="Agregar" onAction="#handleBuscarCodigo"/>
                <TextField fx:id="txtNombre" promptText="Buscar por nombre" prefWidth="250"/>
                <Button text="Buscar" onAction="#handleBuscarNombre"/>
            </HBox>
            <TableView fx:id="tablaItems" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Producto" prefWidth="250"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80"/>
                    <TableColumn fx:id="colPrecio" text="Precio Unit." prefWidth="120"/>
                    <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="8" style="-fx-padding: 15; -fx-background-color: #f4f4f4;">
            <HBox spacing="20">
                <Label text="Subtotal:"/>
                <Label fx:id="lblSubtotal" text="0"/>
                <Label text="Impuesto:"/>
                <Label fx:id="lblImpuesto" text="0"/>
                <Label text="Total:"/>
                <Label fx:id="lblTotal" text="0"
                       style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="txtDescuento" promptText="Descuento %" prefWidth="120"/>
                <Button text="Aplicar Descuento" onAction="#handleAplicarDescuento"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Nueva Venta" onAction="#handleNuevaVenta"/>
                <Button text="Procesar Venta" onAction="#handleProcesarVenta"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>