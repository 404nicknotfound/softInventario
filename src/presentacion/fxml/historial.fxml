<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="presentacion.controllers.HistorialController"
            prefWidth="900" prefHeight="600">

    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #2c3e50;">
            <Button text="← Ventas" onAction="#handleVentas"/>
            <Label text="Historial de Ventas"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Inventario" onAction="#handleInventario"/>
            <Button text="Cerrar Sesión" onAction="#handleCerrarSesion"/>
        </HBox>
    </top>

    <center>
        <SplitPane orientation="VERTICAL">
            <TableView fx:id="tablaVentas">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="220"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="180"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="100"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    <TableColumn fx:id="colItems" text="# Items" prefWidth="80"/>
                </columns>
            </TableView>
            <VBox spacing="5" style="-fx-padding: 10;">
                <Label text="Items de la venta seleccionada:"
                       style="-fx-font-weight: bold;"/>
                <TableView fx:id="tablaItems" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProducto" text="Producto" prefWidth="250"/>
                        <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80"/>
                        <TableColumn fx:id="colPrecio" text="Precio Unit." prefWidth="120"/>
                        <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </SplitPane>
    </center>

</BorderPane>